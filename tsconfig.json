{
    "compilerOptions": {
        "module": "es6",
        "target": "es2024",
        "noImplicitAny": true,
        "strictNullChecks": true,
        "strictPropertyInitialization": true,
        "removeComments": false,
        "preserveConstEnums": true,
        "sourceMap": true,
        "outDir": "./lib",
        "declaration": true
    },
    "include": [
        "src/**/*.ts"
    ]
}