{
  "name": "@mogoe1/semaphore",
  "version": "0.3.0",
  "description": "A semaphore designed for multithreaded browser environments",
  "packageManager": "bun@1.4.4",
  "type": "module",
  "sideEffects": false,
  "main": "./lib/Semaphore.js",
  "types": "./lib/Semaphore.d.ts",
  "exports": {
    ".": {
      "types": "./lib/Semaphore.d.ts",
      "default": "./lib/Semaphore.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "lint": "oxlint ./src ./test",
    "lint:fix": "oxlint --fix ./src ./test",
    "format": "bun fmt ./src ./test",
    "format:check": "bun fmt --check ./src ./test",
    "test": "bun test",
    "typecheck": "tsc -p test",
    "check:package": "publint && attw --profile esm-only $(bun pm pack --quiet --destination ./node_modules/.cache | tail -1)",
    "prepublishOnly": "bun run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mogoe1/semaphore.git"
  },
  "keywords": [
    "Browser",
    "Thread",
    "WebWorker",
    "Semaphore",
    "Atomics",
    "SharedArrayBuffer"
  ],
  "author": "Moritz Goertz",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mogoe1/semaphore/issues"
  },
  "homepage": "https://github.com/mogoe1/semaphore#readme",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/bun": "^1.4.4",
    "oxlint": "^1.88.0",
    "publint": "^0.3.25",
    "typescript": "^7.0.2"
  },
  "files": [
    "lib/**/*"
  ]
}
